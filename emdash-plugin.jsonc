{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-payments",
  "license": "MIT",
  "capabilities": [
    "network:request"
  ],
  "allowedHosts": [
    "dinkuskit.com",
    "payments.dinkuskit.com"
  ],
  "admin": {
    "pages": [
      {
        "path": "/status",
        "label": "Payment settings",
        "icon": "currency-circle-dollar",
        "group": "Dinkus Payments"
      }
    ],
    "settingsSchema": {
      "registry_session": {
        "label": "Payments Registry session",
        "description": "Encrypted Payments Connect session and this plugin's DinkusKit store key. Managed by Connect; don't change it here.",
        "type": "secret"
      }
    }
  },
  "name": "DinkusKit Payments",
  "description": "Connect Stripe to DinkusKit Commerce and check payment readiness from your EmDash admin.",
  "keywords": [
    "payments",
    "stripe",
    "checkout",
    "ecommerce",
    "payment setup"
  ],
  "sections": {
    "description": { "file": "./docs/registry/description.md" },
    "installation": { "file": "./docs/registry/installation.md" },
    "faq": { "file": "./docs/registry/faq.md" }
  },
  "release": {
    "artifacts": {
      "icon": { "file": "./assets/registry/payments.webp" },
      "screenshots": [{ "file": "./assets/registry/payment-setup-demo.jpg", "lang": "en" }]
    }
  },
  "repo": "https://github.com/dinkuskit/payments",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "author": {
    "name": "DinkusKit",
    "url": "https://dinkuskit.com"
  },
  "security": {
    "url": "https://github.com/dinkuskit/payments/security"
  }
}
