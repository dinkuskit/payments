{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-payments",
  "license": "MIT",
  "capabilities": [
    "network:request"
  ],
  "allowedHosts": [
    "dinkuskit.com",
    "payments.dinkuskit.com"
  ],
  "admin": {
    "pages": [
      {
        "path": "/status",
        "label": "Payments status",
        "icon": "activity"
      }
    ],
    "settingsSchema": {
      "registry_session": {
        "label": "Payments Registry session",
        "description": "Encrypted short-lived Payments Registry session. Managed by the connection flow.",
        "type": "secret"
      },
      "storeKey": {
        "label": "Store key",
        "description": "Paste the store key from the Set up Commerce box on DinkusKit.com, the same one pasted into Commerce. The Payments status page trades it there for a short pass each time it checks; it is never sent to Payments itself.",
        "type": "secret"
      }
    }
  },
  "name": "DinkusKit Payments",
  "description": "Payments setup/status surface for DinkusKit stores (Stripe now, Authorize.net later).",
  "keywords": [
    "payments",
    "status"
  ],
  "repo": "https://github.com/dinkuskit/payments",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "author": {
    "name": "DinkusKit",
    "url": "https://github.com/dinkuskit"
  },
  "security": {
    "url": "https://github.com/dinkuskit/payments/security"
  }
}
