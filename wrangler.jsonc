{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dinkus-payments-local",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "durable_objects": { "bindings": [{ "name": "PAYMENT_CONNECTIONS", "class_name": "PaymentConnection" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PaymentConnection"] }],
  "vars": {
    "ACCOUNT_ISSUER": "",
    "ACCOUNT_AUDIENCE": "",
    "ACCOUNT_JWKS_URL": "",
    "ONBOARDING_RETURN_URL": "",
    "ONBOARDING_REFRESH_URL": "",
    "CHECKOUT_SUCCESS_URL": "",
    "CHECKOUT_CANCEL_URL": ""
  }
}
