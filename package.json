{
  "name": "@dinkuskit/payments",
  "version": "0.0.0",
  "description": "The open-source payment-provider plugin for EmDash commerce sites",
  "type": "module",
  "private": true,
  "bin": {
    "dinkus-payments": "./bin/dinkus-payments.mjs"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinkuskit/payments.git"
  },
  "dinkuskit": {
    "pluginId": "dinkus-payments",
    "providerSelection": "one-active-per-store",
    "demoProviders": ["stripe", "authorize_net"],
    "demoCurrencies": [
      "USD"
    ],
    "providerFallback": false,
    "currencyConversion": false
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.mjs tests/cli/*.test.mjs",
    "audit:repo": "node scripts/repo-contract.mjs",
    "verify:quick": "bin/verify-payments quick",
    "verify:full": "bin/verify-payments full",
    "test:runtime": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --include-runtime false",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "jose": "6.2.12",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.3",
    "@cloudflare/workers-types": "5.20260929.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.144.0"
  }
}
