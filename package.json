{
  "name": "@dinkuskit/payments",
  "version": "0.0.0",
  "description": "The open-source payment-provider plugin for EmDash commerce sites",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinkuskit/payments.git"
  },
  "dinkuskit": {
    "pluginId": "dinkus-payments",
    "providerSelection": "one-active-per-store",
    "demoProviders": [
      "stripe",
      "authorize_net"
    ],
    "demoCurrencies": [
      "USD"
    ],
    "providerFallback": false,
    "currencyConversion": false
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.mjs",
    "audit:repo": "node scripts/repo-contract.mjs",
    "plugin:validate": "emdash-plugin validate",
    "plugin:build": "emdash-plugin build --out-dir dist/registry",
    "plugin:bundle": "emdash-plugin bundle --out-dir dist/registry",
    "test:plugin-runtime": "vitest run --config vitest.plugin.config.ts",
    "verify:quick": "bin/verify-payments quick",
    "verify:full": "bin/verify-payments full",
    "proof:stripe-test": "node --import tsx scripts/stripe-test-mode-proof.mjs",
    "proof:registry-status": "node scripts/registry-status-proof.mjs",
    "test:runtime": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.plugin.json",
    "types": "wrangler types --include-runtime false",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "jose": "6.2.12",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "@cloudflare/vitest-plugin": "1.3.3",
    "@cloudflare/workers-types": "5.20260929.1",
    "@emdash-cms/cloudflare": "1.2.0",
    "@emdash-cms/plugin-cli": "0.13.3",
    "@emdash-cms/plugin-test": "0.2.8",
    "astro": "7.3.8",
    "emdash": "1.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.144.0"
  }
}
