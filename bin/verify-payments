#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$script_dir")
cd "$repo_root"

mode="${1:-quick}"

case "$mode" in
  quick)
    npm test
    npm run typecheck
    npm run audit:repo
    ;;
  full)
    "$script_dir/verify-payments" quick
    npm run test:runtime
    npm run build
    npm run plugin:validate
    npm run plugin:build
    npm run test:plugin-runtime
    ;;
  *)
    echo "Usage: bin/verify-payments [quick|full]" >&2
    exit 64
    ;;
esac

printf "verify-payments: %s passed\n" "$mode"
